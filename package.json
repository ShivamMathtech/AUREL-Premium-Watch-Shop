{
  "name": "aurel-watch-shop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite --host 0.0.0.0",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "preview": "vite preview --host 0.0.0.0",
    "setup": "node scripts/setup.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "admin:create": "node --env-file-if-exists=.env scripts/admin.mjs",
    "orders:reconcile": "node --env-file-if-exists=.env scripts/reconcile.mjs"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.0",
    "stripe": "^18.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.4.1"
  }
}
