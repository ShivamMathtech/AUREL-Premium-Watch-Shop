# Node.js 24 LTS. Run npm run setup to create .env with a random local admin password.
PORT=3001
APP_URL=http://localhost:5173
# Empty = SQLite locally. Required for full-stack Vercel; use a pooled PostgreSQL URL.
DATABASE_URL=
SQLITE_PATH=./data/aurel.sqlite
ADMIN_EMAIL=admin@aurel.local
ADMIN_PASSWORD=
# auto = discover backend; demo = browser-only showcase; live = require API.
VITE_APP_MODE=auto
# Optional Stripe Checkout. Both keys required to enable the card option.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# On Vercel set APP_URL to the exact HTTPS origin of your deployed store.
